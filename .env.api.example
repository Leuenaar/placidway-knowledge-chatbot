# Copy to .env.api (git-ignored). Used only by the API server and by "npm run search" / "npm run ask".
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# A secret key for the server (sb_secret_...). Never the publishable key, never put it in the web app.
SUPABASE_API_KEY=
# Key for the model that writes the answers (Anthropic Console). Server only.
ANTHROPIC_API_KEY=
# Optional. Default is claude-haiku-5-5. Change the model here, no code edit needed.
# ANTHROPIC_MODEL=claude-haiku-5-5
# Optional. How much the model may think before it writes the ANSWER: low, medium (default), high, xhigh, max,
# or "default" (send nothing and use the API's own default).
# ANTHROPIC_EFFORT=medium
# The same for the small step that rewrites the visitor's message into a search query. Default: low.
# ANTHROPIC_REWRITE_EFFORT=low
# Only if the API answers "This API key is not scoped to a workspace": the id of the workspace to use.
# ANTHROPIC_WORKSPACE_ID=
# Optional. How many chunks go to the answer step (1 to 20, default 8). More chunks catch a short price chunk that ranks low,
# but cost more tokens and a little more time.
# RETRIEVE_COUNT=8
# Optional. How many pages are sent in full next to the search hits (0 to 7, default 2, 0 = off). The search finds the right
# page; sending the page's other chunks too keeps a short but important chunk (like the price tiers) from being missed.
# EXPAND_PAGES=2
# Limits on the paid model calls (live mode). All optional, defaults shown.
# Messages per visitor address in a sliding 10 minutes, and per UTC day:
# RATE_LIMIT_PER_10_MIN=15
# RATE_LIMIT_PER_DAY=100
# Tokens (input + output) the model may use per UTC day over all visitors. One chat message uses about 15,000.
# DAILY_TOKEN_BUDGET=5000000
# Chats answered at the same time:
# MAX_CONCURRENT_CHATS=8
# Number of proxies in front of the server. Set 1 behind nginx, otherwise every visitor shares one limit.
# TRUST_PROXY=0
